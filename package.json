{
  "name": "standards-auditor",
  "version": "0.2.0-alpha.5",
  "description": "Auditor configurable de estándares de ingeniería mediante paquetes YAML",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "standards-auditor": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soporte605/standards-auditor.git"
  },
  "bugs": "https://github.com/soporte605/standards-auditor/issues",
  "files": [
    "dist",
    "packs/*.yaml",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "examples",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md",
    "!docs/img"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run format:check && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "open": "^11.0.4",
    "typescript": "~5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "prettier": "^3.9.9"
  }
}
